# ==============================================================================
# HACKATHON ENVIRONMENT VARIABLES (.env.example)
# Skopiuj ten plik do .env.local podczas lokalnego developmentu:
#   cp .env.example .env.local
# ==============================================================================

# Supabase — URL projektu (z panelu Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase — Publiczny klucz anonimowy (Project Settings -> API -> anon public)
# Uwaga: w nowszych wersjach Supabase klucz ten bywa nazywany "Publishable key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Flaga wymuszenia trybu demo (opcjonalnie: ustaw na "true" aby domyślnie używać mocków bez łączenia z bazą)
# Alternatywnie: wystarczy dopisać ?demo=true w pasku adresu przeglądarki
NEXT_PUBLIC_DEMO_MODE=false
